# syntax=docker/dockerfile:1
#
# The read side, as a service. Split from the pipeline image because it is a
# different kind of container: the steps are one-shot jobs that exit, this one
# stays up, holds a model resident and answers HTTP.
#
#   docker build -f Dockerfile.api -t rag-search-api .
#   docker run --rm -p 8000:8000 -v hf-models:/models \
#              -e RAG_DSN=postgresql://postgres:postgres@db/docs \
#              rag-search-api
#
#   curl -s localhost:8000/search -H 'content-type: application/json' \
#        -d '{"query": "what were the Q3 logistics costs?"}'
#
# The dependency layers are deliberately identical to Dockerfile's up to the
# `--extra api`, so the two images share them in the local cache and in a
# registry: the ~1.7 GB of torch is pulled and stored once, not twice.
#
# GPU build: --build-arg TORCH_EXTRA=cu126

FROM python:3.12-slim

# Pinned to the version that wrote uv.lock, as in Dockerfile.
COPY --from=ghcr.io/astral-sh/uv:0.7.9 /uv /uvx /bin/

# Still needed here: the embedder imports docling's chunker, and docling pulls
# opencv at import time. The service never parses anything, but it does not get
# to skip the import.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    # This one earns more here than in the batch image: the container is
    # long-lived, but it is also restarted by the orchestrator, and paying
    # torch's import-time compile on every restart is time spent not serving.
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

ARG TORCH_EXTRA=cpu

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --extra ${TORCH_EXTRA} --extra api

# Weights on a volume, same as the pipeline image — and the same volume, which
# is the point: the service must load the model the indexer indexed with.
ENV HF_HOME=/models

# Optional: bake the embedding model (~2.1 GB) into the image. Worth more for
# this image than for the batch one — a service that has to download 2.1 GB
# before its first response is a slow rollout, not a slow job. The docling
# layout models are deliberately not fetched; nothing here parses.
ARG PREFETCH_MODELS=0
ARG PREFETCH_EMBED_MODEL=BAAI/bge-m3
RUN if [ "$PREFETCH_MODELS" = "1" ]; then \
      python -c "import sys; from sentence_transformers import SentenceTransformer; SentenceTransformer(sys.argv[1])" \
             "$PREFETCH_EMBED_MODEL"; \
    fi

COPY rag_embeddings ./rag_embeddings
# Only the serving entrypoint. The step and worker scripts are the other
# image's; nothing in this one should be able to start a parse.
COPY serve.py ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --extra ${TORCH_EXTRA} --extra api

RUN mkdir -p /models

# Documentation only — publishing the port is the run's decision. The service
# binds RAG_API_HOST:RAG_API_PORT, which default to 0.0.0.0:8000.
EXPOSE 8000

# One service, one entrypoint: unlike the pipeline image, there is nothing else
# this container could usefully be.
ENTRYPOINT ["python", "serve.py"]
